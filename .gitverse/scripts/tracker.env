# Провайдерские настройки GitVerse-адаптера (.gitverse/scripts/tracker-notify.sh).
# Формат KEY=value, читается через source; провайдерское живёт только здесь.

# Хост ссылок в комментариях и шаблоны путей с плейсхолдером __VALUE__.
webBase=https://gitverse.ru/averkhogliad/tube-loader
branchPath=/content/__VALUE__
prPath=/pulls/__VALUE__

# Имя переменной окружения с токеном: значение приходит из секрета репозитория.
tokenEnv=WEEEK_API_TOKEN

# Скрипт домена (путь от корня репозитория), принимающий команды notify-push и notify-pr.
dispatcher=scripts/weeek/weeek.sh
