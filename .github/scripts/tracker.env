# Provider settings of the GitHub adapter (.github/scripts/tracker-notify.sh).
# Format KEY=value, sourced; provider-specific bits live here only.

# Link host in comments and path templates with the __VALUE__ placeholder.
webBase=https://github.com/averkhogliad/tube-loader
branchPath=/tree/__VALUE__
prPath=/pull/__VALUE__
commitPath=/commit/__VALUE__

# Author profile URL resolver command: exactly one argument — the commit author name,
# exactly one answer — the profile url or an empty string. Path is relative to the repo root.
# The mechanism is entirely provider-side; the shared CI layer knows nothing about it;
# no key — no resolution.
authorUrlCommand=.github/scripts/resolve-author-url.sh

# Name of the environment variable holding the token: the value comes from a repo secret.
tokenEnv=WEEEK_API_TOKEN
