# Провайдерские настройки GitHub-адаптера (.github/scripts/tracker-notify.sh).
# Формат KEY=value, читается через source; провайдерское живёт только здесь.

owner=averkhogliad
repo=tube-loader

# Хост ссылок в комментариях Weeek и провайдерские шаблоны путей (__VALUE__ — плейсхолдер).
webBase=https://github.com/averkhogliad/tube-loader
branchPath=/tree/__VALUE__
prPath=/pull/__VALUE__

# Имя переменной окружения с токеном Weeek: значение приходит из секрета репозитория.
tokenEnv=WEEEK_API_TOKEN
